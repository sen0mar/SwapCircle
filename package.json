{
  "name": "swapcircle",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": "24.13.0",
    "pnpm": "11.5.3"
  },
  "scripts": {
    "dev": "pnpm --filter @swapcircle/contracts build && pnpm --filter @swapcircle/web dev",
    "typecheck": "pnpm --filter @swapcircle/contracts build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @swapcircle/contracts build && pnpm -r --if-present test",
    "build": "pnpm -r build",
    "test:browser": "pnpm --filter @swapcircle/web test:browser"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
