{
  "name": "swapcircle",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": "24.13.0",
    "pnpm": "11.5.3"
  },
  "scripts": {
    "dev": "pnpm --filter @swapcircle/contracts build && pnpm --filter @swapcircle/web dev",
    "typecheck": "pnpm --filter @swapcircle/contracts build && pnpm --filter @swapcircle/database build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/*.test.mjs && pnpm --filter @swapcircle/contracts build && pnpm -r --if-present test",
    "build": "pnpm -r build",
    "test:browser": "pnpm --filter @swapcircle/web test:browser",
    "db:start": "pnpm --filter @swapcircle/database local start",
    "db:stop": "pnpm --filter @swapcircle/database local stop",
    "db:setup": "pnpm --filter @swapcircle/database local setup",
    "db:reset": "pnpm --filter @swapcircle/database local reset",
    "db:migrate": "pnpm --filter @swapcircle/database local migrate",
    "db:seed": "pnpm --filter @swapcircle/database local seed",
    "db:verify": "pnpm --filter @swapcircle/database local verify",
    "test:api-local": "node scripts/test-local-suites.mjs api",
    "test:journeys-local": "node scripts/test-local-suites.mjs journeys",
    "backup:local": "pnpm --filter @swapcircle/database backup"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sentry/cli": "3.8.0",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
