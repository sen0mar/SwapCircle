{
  "name": "@swapcircle/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "build": "tsc",
    "dev": "pnpm build && node --env-file-if-exists=.env --watch dist/server.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:auth-local": "pnpm --filter @swapcircle/contracts build && pnpm build && node test/local-auth.mjs",
    "test:profiles-local": "pnpm --filter @swapcircle/contracts build && pnpm --filter @swapcircle/database build && pnpm build && node --env-file=../../packages/database/.env test/local-profiles.mjs"
  },
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@swapcircle/contracts": "workspace:*",
    "@swapcircle/database": "workspace:*",
    "cors": "^2.8.6",
    "pg": "8.23.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "vitest": "^5.0.1"
  }
}
